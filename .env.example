# Environment variables for GPPS-Website (Next.js on Vercel)
# Copy this file to .env.local for local dev. In Vercel, set these in Project Settings → Environment Variables.

# NextAuth (credentials provider)
NEXTAUTH_URL=
NEXTAUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database
MONGODB_URI=
# Optional legacy fallback key your code also supports (prefer MONGODB_URI)
MongoClient=

# Email (SMTP) — if omitted, emails will be logged to console as fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=
NOTIFY_TO=

# ISR / On-Demand Revalidation
REVALIDATE_SECRET=

# Site URL used in sitemap generation
SITE_URL=
